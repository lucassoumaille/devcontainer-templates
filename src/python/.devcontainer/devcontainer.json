{
    "name": "Python 3",
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "VARIANT": "${templateOption:imageVariant}"
        }
    },
    "remoteUser": "vscode",
    "features": {
        "ghcr.io/devcontainers/features/node:2": {
            "version": "22"
        },
        "ghcr.io/lucassoumaille/devcontainer-features/ai-tools:1": {}
    },
    "runArgs": [
        "--cap-drop=ALL",
        "--security-opt=no-new-privileges"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "charliermarsh.ruff"
            ]
        }
    },
    "postCreateCommand": "if [ -f pyproject.toml ]; then pip install -e '.[dev]'; fi"
}
