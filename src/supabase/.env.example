# Copy to .env (ignored by git) or set as Codespaces secrets. No quotes, no spaces around "=".
# Used by `make remote-diff` / `make remote-push`. Never put service_role / secret API keys here.

# Personal access token: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Staging project: reference ID (Project Settings > General) and database password.
SUPABASE_PROJECT_ID_STAGING=
SUPABASE_DB_PASSWORD_STAGING=
