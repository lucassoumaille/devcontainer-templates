#!/usr/bin/env bash
set -Eeuo pipefail

# Runs `make check` when the pushed commits change anything under supabase/.
# Enabled by scripts/bootstrap.sh (git config core.hooksPath .githooks).
# Bypass in an emergency: git push --no-verify (CI still runs the same checks).
# Note: the checks run on the working tree, so stash uncommitted work for a faithful result.

base_ref="${MIGRATIONS_BASE_REF:-origin/main}"
needs_check=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ "${local_sha}" =~ ^0+$ ]] && continue
  if [[ "${remote_sha}" =~ ^0+$ ]]; then
    # New remote branch: compare with the base branch, or check everything if it is unknown.
    if ! remote_sha="$(git merge-base "${base_ref}" "${local_sha}" 2> /dev/null)"; then
      needs_check=1
      continue
    fi
  fi
  # Remote commit not fetched locally: cannot compute the diff, check everything.
  if ! git cat-file -e "${remote_sha}^{commit}" 2> /dev/null \
    || ! git diff --quiet "${remote_sha}" "${local_sha}" -- supabase/; then
    needs_check=1
  fi
done

if (( needs_check == 0 )); then
  exit 0
fi

echo "pre-push: supabase/ changed, running make check (bypass: git push --no-verify)"
make check
